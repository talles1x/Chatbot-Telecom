# ===== SGP =====
# Endereço do seu SGP, sem barra no final (ex: https://suaempresa.sgp.net.br)
SGP_URL=https://SEU-SGP.sgp.net.br
# Token e App gerados em Administração > Integrações > Tokens
SGP_TOKEN=cole-o-token-aqui
SGP_APP=botfinanceiro
# Formato do corpo das requisições: json ou form
SGP_FORMATO=json
# true = usa dados falsos (para testar o fluxo sem o SGP)
SGP_MOCK=false

# ===== MODO TESTE =====
# Se preencher, o bot SÓ responde estes números (DDI+DDD+número, separados por vírgula).
# Deixe vazio para responder todo mundo.
TESTE_NUMEROS=5583999999999
# Números que o bot nunca responde (funcionários, fornecedores...)
IGNORAR_NUMEROS=

# ===== ATENDIMENTO =====
# (Opcional) Número que recebe o resumo de cada ocorrência de suporte técnico,
# pronto para abrir no SGP (ex.: WhatsApp do técnico, com 55 + DDD).
NUMERO_EQUIPE=
# (Opcional) Número que recebe os interessados em contratar. Vazio = usa o NUMERO_EQUIPE.
NUMERO_COMERCIAL=
EMPRESA_NOME=MinhaTelecom

# ===== EQUIPE =====
# Números da equipe que recebem o menu próprio (fechar o caixa, avisar pré-cadastro,
# falar com atendente) em vez do menu de cliente. Separe por vírgula.
ATENDENTE_NUMEROS=
# Números dos técnicos: menu próprio (consultar cliente, ver se está online, criar ocorrência
# no SGP, falar com atendente). Separe por vírgula; o nome é opcional: 5583999999999=Fulano
# O token do SGP precisa poder abrir chamado.
TECNICO_NUMEROS=
# Fechar o caixa: soma só os pagamentos do dia baixados pelos usuários do SGP de cada caixa.
# O token do SGP precisa ter permissão para listar faturas (Fatura - Listar).
# Vários caixas: Nome|usuários do SGP|números que podem fechar, separando os caixas com ;
# Quem tem mais de um caixa escolhe qual fechar. Os números daqui também recebem o menu da equipe.
# Ex.: CAIXAS=Loja Centro|joao|5583999999999;Loja Bairro|maria,ana|5583999999999,5583888888888
CAIXAS=
# Formato simples (um caixa só, para todos de ATENDENTE_NUMEROS), usado quando CAIXAS fica vazio:
CAIXA_USUARIOS_SGP=
CAIXA_NOME=
# Dias de atendimento (0=domingo ... 6=sábado)
HORARIO_DIAS=1,2,3,4,5,6
HORARIO_TURNOS=08:00-12:00,13:00-17:00
# Como o horário aparece para o cliente (mude junto se alterar dias/turnos)
HORARIO_TEXTO=segunda a sábado, das 8h às 12h e das 13h às 17h
FUSO=America/Fortaleza

# Promessa de pagamento liberada a partir de X dias de atraso (dia do bloqueio)
PROMESSA_MIN_DIAS=11
# Quantos dias a liberação de confiança dura (deixe igual ao configurado no SGP)
PROMESSA_DIAS=2
# Fatura mais antiga com X dias de atraso ou mais (75 = 2,5 meses): bot oferece acordo
ACORDO_MIN_DIAS=75

# Depois que o atendente assume (ou o cliente pede atendente), o bot fica calado
# nessa conversa por X horas. O atendente pode mandar #bot na conversa para religar,
# e ao encerrar ("atendimento finalizado", "agradecemos o contato" ou #fim) o bot volta sozinho.
PAUSA_HUMANO_HORAS=3
# Conversa parada por X minutos volta para o menu inicial
SESSAO_MIN=30
# Cliente parado no meio do fluxo: lembrete depois de X minutos e encerra após mais X (0 = desliga)
LEMBRETE_MIN=10
# Junta mensagens seguidas do cliente enviadas dentro desse tempo (milissegundos)
AGRUPAR_MS=2500

# Menu como enquete clicável do WhatsApp (true) ou texto numerado (false, recomendado:
# nesta versão do WhatsApp Web o toque na enquete nem sempre chega ao bot)
USAR_ENQUETE=false

# Conversas atendidas pelo bot ficam como NÃO LIDAS no celular, para o atendente acompanhar (true/false)
MANTER_NAO_LIDA=true

# ===== LGPD =====
# Quantos CPFs/CNPJs diferentes um mesmo WhatsApp pode consultar por dia (passou disso, vai para o atendente)
LIMITE_CPFS_DIA=3

# ===== ANTI-BANIMENTO =====
# Tempo "digitando..." antes de cada resposta (milissegundos)
DELAY_MIN_MS=800
DELAY_MAX_MS=2500

# ===== ÁUDIO =====
# Transcreve áudios dos clientes no próprio computador (Whisper local, gratuito)
TRANSCREVER_AUDIO=true
# Modelo: Xenova/whisper-base (rápido, ~80 MB) ou Xenova/whisper-small (mais preciso, mais lento, ~250 MB)
WHISPER_MODELO=Xenova/whisper-base
# Áudios maiores que isso são cortados
AUDIO_MAX_SEGUNDOS=90

# Mostra no terminal as respostas cruas do SGP (para conferir os campos)
DEBUG=false
